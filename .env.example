# Copy to .env and replace every placeholder. .env is gitignored — keep it that way.
# docker compose reads .env automatically; Spring imports it via spring.config.import.
# Comments on their own line only: Spring parses this as .properties (no inline comments).

# --- Container credentials ---
ENV_DB_USER=hookrelay
ENV_DB_PASSWORD=change-me-db
ENV_DB_NAME=hookrelay
ENV_RABBIT_USER=hookrelay
ENV_RABBIT_PASSWORD=change-me-rabbit

# --- Connections (app on host -> containers on 127.0.0.1) ---
# JDBC form, not postgres://
ENV_DB_URL=jdbc:postgresql://127.0.0.1:5432/hookrelay
ENV_RABBIT_URL=amqp://hookrelay:change-me-rabbit@127.0.0.1:5672
ENV_REDIS_URL=redis://127.0.0.1:6379

# --- Secrets ---
# exactly 32 bytes, base64: encrypts endpoint secrets
ENV_MASTER_KEY=base64-32-bytes
# >= 32 chars
ENV_JWT_SECRET=long-random-secret
# >= 24 chars, static bearer token for scripts
ENV_ADMIN_TOKEN=long-random-token
# scrypt:<saltB64>:<hashB64>
ENV_ADMIN_PASSWORD_HASH=scrypt:salt:hash

# --- ingest ---
ENV_PORT=3000

# --- gateway ---
ENV_ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- worker egress ---
ENV_ALLOW_HTTP=false
ENV_SSRF_ALLOW_IPS=
