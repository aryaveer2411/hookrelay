# Copy to .env and replace every placeholder, or run `npm run env:init`
# to generate one with real random secrets. .env is gitignored — keep it that way.

# --- Container credentials (docker-compose builds the URLs below from these) ---
ENV_DB_USER=hookrelay
ENV_DB_PASSWORD=change-me-db
ENV_DB_NAME=hookrelay
ENV_RABBIT_USER=hookrelay
ENV_RABBIT_PASSWORD=change-me-rabbit

# --- Connections (used when running the apps on the host; compose overrides them) ---
ENV_DB_URL=postgres://user:password@127.0.0.1:5432/hookrelay
ENV_RABBIT_URL=amqp://user:password@127.0.0.1:5672
ENV_REDIS_URL=redis://127.0.0.1:6379

# --- Secrets ---
ENV_MASTER_KEY=base64-32-bytes        # exactly 32 bytes, base64: encrypts endpoint secrets
ENV_JWT_SECRET=long-random-secret     # >= 32 chars, shared by ingest and gateway
ENV_ADMIN_TOKEN=long-random-token     # >= 24 chars, static bearer token for scripts
ENV_ADMIN_PASSWORD_HASH=scrypt:salt:hash   # scrypt:<saltB64>:<hashB64>

# --- ingest ---
ENV_PORT=3000

# --- gateway (required, no default) ---
ENV_ALLOWED_ORIGINS=http://127.0.0.1:5173

# --- worker egress ---
ENV_ALLOW_HTTP=false                  # true only to reach the http mock-target
ENV_SSRF_ALLOW_IPS=
